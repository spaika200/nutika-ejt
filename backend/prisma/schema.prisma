generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  MASTER
  STANDARD
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  role      Role     @default(STANDARD)
  devices   Device[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Device {
  id               Int       @id @default(autoincrement())
  name             String
  description      String?
  connectionType   String    // 'IP', 'API', 'MQTT'
  connectionParams String    // JSON string or specific fields
  status           Boolean   @default(false)
  thresholdPrice   Float?    // Price threshold in EUR/MWh
  isCritical       Boolean   @default(false) // For Holiday mode
  manualOverride   Boolean   @default(false)
  userId           Int
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs             DeviceLog[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model DeviceLog {
  id        Int      @id @default(autoincrement())
  command   String   // 'ON', 'OFF', 'STATUS_CHECK'
  deviceId  Int
  device    Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  timestamp DateTime @default(now())
}

model HistoricalPrice {
  id        Int      @id @default(autoincrement())
  timestamp Int      // Unix timestamp (seconds) - unique per hour
  priceEur  Float    // Price in EUR/MWh
  region    String   @default("ee") // Estonia
  fetchedAt DateTime @default(now())
  
  @@unique([timestamp, region])
  @@index([timestamp])
}
