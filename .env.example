# ============================================
# NUTIKA EJT - Environment Configuration
# ============================================

# ============================================
# DATABASE (Neon PostgreSQL)
# ============================================
DATABASE_URL=postgresql://neondb_owner:#####################-dream-apv718f4-pooler.c-7.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# ============================================
# REDIS (for caching and sessions)
# ============================================
REDIS_URL=redis://redis:6379

# ============================================
# APPLICATION
# ============================================
NODE_ENV=production
PORT=5000
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# ============================================
# FRONTEND (React)
# ============================================
VITE_API_URL=http://localhost:5000
VITE_APP_NAME=Nutika Elektrivõrgu Juhtimiskeskus

# ============================================
# TELEGRAM NOTIFICATIONS
# ============================================
TELEGRAM_BOT_TOKEN=#############################
TELEGRAM_CHAT_ID=your-telegram-chat-id

# ============================================
# MONITORING & LOGGING
# ============================================
LOG_LEVEL=info
LOKI_ENABLED=true
LOKI_URL=http://loki:3100

# ============================================
# EXTERNAL APIs
# ============================================
# Elering API is public, no auth needed
ELERING_API_URL=https://dashboard.elering.ee/api/nps/price
